/**
 * Season Operations — results entry.
 *
 * This is the operational, scalable counterpart to the older hardcoded
 * Division Data test screen. It discovers Division workbooks generated by the
 * Season Master system, loads only the chosen workbook, and saves one complete
 * round in a single deliberate write.
 */
const F1XL_RESULTS_ENTRY = Object.freeze({
  listCacheKey:'F1XL_RESULTS_ENTRY_LIST_V3',
  divisionCachePrefix:'F1XL_RESULTS_ENTRY_DIVISION_V3_',
  roundCachePrefix:'F1XL_RESULTS_ENTRY_ROUND_V3_',
  cacheSeconds:120
});

// One execution-local timing record. No names, IDs, inputs or error text are
// logged. Telemetry failure must never change the outcome of a save.
var fapPerformanceTrace_=null;
function fapPerformanceMeasure_(operation,work){
  const previous=fapPerformanceTrace_,trace={operation:operation,phases:{},ok:false},started=Date.now();
  fapPerformanceTrace_=trace;
  try{const result=work();trace.ok=true;return result;}
  finally{fapPerformanceTrace_=previous;try{console.info(JSON.stringify({message:'FAP performance v1',operation:operation,ok:trace.ok,totalMs:Date.now()-started,phases:trace.phases}));}catch(ignore){}}
}
function fapPerformancePhase_(name,work){
  const trace=fapPerformanceTrace_;if(!trace)return work();const started=Date.now();
  try{return work();}finally{const p=trace.phases[name]||(trace.phases[name]={ms:0,calls:0});p.ms+=Date.now()-started;p.calls++;}
}
function fapPerformanceLock_(work){
  const lock=LockService.getScriptLock();
  fapPerformancePhase_('lock.wait',function(){lock.waitLock(30000);});
  try{return fapPerformancePhase_('lock.held',work);}finally{lock.releaseLock();}
}

function getResultsEntryInitial(forceRefresh) { fapAssertEntry_('getResultsEntryInitial');
  const cache = CacheService.getScriptCache();
  if (forceRefresh === true) cache.remove(F1XL_RESULTS_ENTRY.listCacheKey);
  const cached = cache.get(F1XL_RESULTS_ENTRY.listCacheKey);
  if (cached) return JSON.parse(cached);

  const properties = PropertiesService.getScriptProperties().getProperties();
  const seasons = Object.keys(properties).filter(function(key) {
    return key.indexOf(F1XL_SEASON_MASTER.propertyPrefix) === 0;
  }).map(function(key) {
    const season = key.substring(F1XL_SEASON_MASTER.propertyPrefix.length).replace(/_/g, '.');
    const divisions = [];
    for (let division = 1; division <= F1XL_CAPACITY.divisions; division += 1) {
      const spreadsheetId = properties[divisionTemplatePropertyKey_(season, division)] || '';
      if (spreadsheetId) divisions.push({ division:division, spreadsheetId:spreadsheetId });
    }
    const readOnly=seasonProtectionStatus_(season).readOnly;
    const record=typeof testLaunchRecord_==='function'?testLaunchRecord_(season):{};
    const book=!readOnly&&record.launchedAt?SpreadsheetApp.openById(properties[key]):null;
    return { season:season, divisions:divisions, readOnly:readOnly, active:!!book&&testLaunchActive_(book), launchedAt:record.launchedAt||'' };
  }).filter(function(item) {
    return item.divisions.length > 0 && item.active;
  }).sort(function(a, b) {
    return b.launchedAt.localeCompare(a.launchedAt) || Number(b.season)-Number(a.season);
  }).slice(0,1);

  const response = {
    ok:true,
    seasons:seasons,
    refreshedAt:new Date().toISOString(),
    message:seasons.length
      ? 'Season '+seasons[0].season+' is active. Choose a division.'
      : 'Launch a season before entering weekly results. Historical corrections use the archive workflow.'
  };
  cache.put(F1XL_RESULTS_ENTRY.listCacheKey, JSON.stringify(response), F1XL_RESULTS_ENTRY.cacheSeconds);
  return response;
}

function getResultsEntryDivision(input, forceRefresh) { fapAssertEntry_('getResultsEntryDivision');
  const selection = normaliseResultsEntrySelection_(input);
  const cache = CacheService.getScriptCache();
  const key = resultsEntryDivisionCacheKey_(selection);
  if (forceRefresh === true) cache.remove(key);
  const cached = cache.get(key);
  if (cached) return JSON.parse(cached);

  const context = openResultsEntryContext_(selection);
  if(input&&input.indexOnly===true){
    // The calendar labels are enough to choose a round. Completion checks read
    // saved results separately; never label an unchecked round Empty/Complete.
    const calendar=context.calendarSheet.getRange(2,1,F1XL_CAPACITY.rounds,4).getDisplayValues(),byRound={};
    calendar.forEach(function(r){const n=Number(r[0]);if(Number.isInteger(n)&&n>0)byRound[n]=r;});
    return {ok:true,sourceName:context.spreadsheet.getName(),season:selection.season,division:selection.division,workbookUrl:context.spreadsheet.getUrl(),readOnly:seasonProtectionStatus_(selection.season).readOnly||seasonProtectionForWorkbook_(context.spreadsheet).readOnly,progressPending:true,
      rounds:context.spreadsheet.getSheets().filter(function(s){return /^R\d+$/i.test(s.getName());}).map(function(s){const n=Number(s.getName().slice(1)),r=byRound[n]||[],type=String(r[1]||'');return {sheetName:s.getName(),round:n,circuit:/^#/.test(String(r[3]||''))?'':String(r[3]||''),format:/^(early|legacy)\s+sprint/i.test(type)?'Legacy Sprint':/sprint/i.test(type)?'Modern Sprint':'Standard',progress:null};}).sort(function(a,b){return a.round-b.round;})};
  }
  const overview = {ok:true,sourceName:context.spreadsheet.getName(),rounds:context.spreadsheet.getSheets().filter(function(s){return /^R\d+$/i.test(s.getName());}).map(function(s){
    const values=resultsEntryRoundValues_(s),type=String(values[6]&&values[6][0]||''),sprint=/sprint/i.test(type);
    return {sheetName:s.getName(),round:Number(s.getName().slice(1)),circuit:String(values[0]&&values[0][4]||''),format:/^(early|legacy)\s+sprint/i.test(type)?'Legacy Sprint':sprint?'Modern Sprint':'Standard',progress:resultsEntryProgressValues_(values)};
  }).sort(function(a,b){return a.round-b.round;})};
  overview.readOnly = seasonProtectionStatus_(selection.season).readOnly || seasonProtectionForWorkbook_(context.spreadsheet).readOnly;
  overview.season = selection.season;
  overview.division = selection.division;
  overview.workbookUrl = context.spreadsheet.getUrl();
  cache.put(key, JSON.stringify(overview), F1XL_RESULTS_ENTRY.cacheSeconds);
  return overview;
}

function getResultsEntryRound(input, forceRefresh) { fapAssertEntry_('getResultsEntryRound');
  const selection = normaliseResultsEntrySelection_(input);
  const sheetName = divisionDataText_(input && input.sheetName);
  if (!/^R\d+$/i.test(sheetName)) throw new Error('Choose a valid round first.');
  const cache = CacheService.getScriptCache();
  const key = resultsEntryRoundCacheKey_(selection, sheetName);
  if (forceRefresh === true) cache.remove(key);
  const cached = cache.get(key);
  if (cached) return resultsEntryPublicationState_(JSON.parse(cached),selection);

  const context = openResultsEntryContext_(selection);
  const sheet = findDivisionRoundSheet_(context, sheetName);
  const response = buildDivisionRound_(context, sheet);
  response.readOnly = seasonProtectionStatus_(selection.season).readOnly || seasonProtectionForWorkbook_(context.spreadsheet).readOnly;
  response.season = selection.season;
  response.division = selection.division;
  response.workbookUrl = context.spreadsheet.getUrl();
  response.progress=resultsEntrySheetProgress_(sheet);
  if(resultsEntryCancelled_(selection,sheetName)){response.readOnly=true;response.lockedReason='This round is cancelled in the season calendar. Restore it there before entering results.';}
  cache.put(key, JSON.stringify(response), F1XL_RESULTS_ENTRY.cacheSeconds);
  return resultsEntryPublicationState_(response,selection);
}

function saveResultsEntryRound(input) { fapAssertEntry_('saveResultsEntryRound');
  assertSeasonWritable_(input && input.season);
  return fapPerformanceMeasure_('results.save',function(){return fapPerformanceLock_(function() {
    const selection = normaliseResultsEntrySelection_(input);
    const current=fapPerformancePhase_('season.check',function(){return getResultsEntryInitial(true).seasons[0];});
    if(!current||current.season!==selection.season)throw new Error('Weekly results entry is for the active season only. Refresh to open it.');
    if(resultsEntryCancelled_(selection,input.sheetName))throw new Error('This round is cancelled in the season calendar. Restore it there before entering results.');
    resultsEntryCheckDrivers_(input.sessions);
    const context = openResultsEntryContext_(selection);
    const timeAdjustments=typeof resultsAdjustmentPrepare_==='function'?resultsAdjustmentPrepare_(context,input,selection):[];
    if(timeAdjustments.length)resultsAdjustmentWriteJournal_(timeAdjustments);
    const response = saveDivisionRoundToContext_(context, input);
    if(timeAdjustments.length){try{resultsAdjustmentFinish_(timeAdjustments);}catch(e){response.message+=' Time-adjustment recovery record retained; the next preview will recognise the saved times.';}}
    if(testLaunchRecord_(selection.season).sourceMode!==F1XL_DIRECT_SOURCE_MODE){
      const pending=resultsEntryPending_(selection);
      if(pending.indexOf(response.sheetName)<0)pending.push(response.sheetName);
      PropertiesService.getScriptProperties().setProperty(resultsEntryPendingKey_(selection),JSON.stringify(pending));
    }
    response.season = selection.season;
    response.division = selection.division;
    response.workbookUrl = context.spreadsheet.getUrl();
    response.progress=resultsEntrySheetProgress_(context.spreadsheet.getSheetByName(response.sheetName));
    const cache = CacheService.getScriptCache();
    cache.remove(resultsEntryDivisionCacheKey_(selection));
    cache.remove(resultsEntryRoundCacheKey_(selection, response.sheetName));
    return resultsEntryPublicationState_(response,selection);
  });});
}

function resultsEntryCheckDrivers_(sessions) {
  (sessions||[]).forEach(function(session){
    const seen=Object.create(null);(session.rows||[]).forEach(function(row){
      const name=String(row[/qualifying/i.test(session.id)?2:1]||'').trim().toLowerCase();
      if(!name)return;if(seen[name])throw new Error('A driver appears twice in '+session.id+'. Remove the duplicate before saving.');seen[name]=true;
    });
  });
}
function resultsEntryPendingKey_(selection){return 'F1XL_RESULTS_PUBLICATION_V1_'+selection.season+'_'+selection.division;}
function resultsEntryPending_(selection){if(testLaunchRecord_(selection.season).sourceMode===F1XL_DIRECT_SOURCE_MODE)return [];return JSON.parse(PropertiesService.getScriptProperties().getProperty(resultsEntryPendingKey_(selection))||'[]');}
function resultsEntryPublicationState_(response,selection){response.publicationPending=resultsEntryPending_(selection).length>0;response.directSources=testLaunchRecord_(selection.season).sourceMode===F1XL_DIRECT_SOURCE_MODE;return response;}

/** A separate request lets the browser distinguish a saved result from a failed public refresh.
 * The persistent queue survives reloads and only clears after every public write succeeds. */
function publishResultsEntryRound(input){ fapAssertEntry_('publishResultsEntryRound');
  return fapPerformanceMeasure_('results.publish',function(){return fapPerformanceLock_(function(){
    const selection=normaliseResultsEntrySelection_(input);
    assertSeasonWritable_(selection.season);
    const current=fapPerformancePhase_('season.check',function(){return getResultsEntryInitial(true).seasons[0];});
    if(!current||current.season!==selection.season)throw new Error('Refresh to open the active season before updating its website.');
    const pending=resultsEntryPending_(selection);
    if(!pending.length)return {ok:true,publicationPending:false,message:'The saved results are already published.'};
    testLaunchUpdateResults_(selection,pending);
    PropertiesService.getScriptProperties().deleteProperty(resultsEntryPendingKey_(selection));
    return {ok:true,publicationPending:false,message:'Results saved and the website updated.'};
  });});
}

/** Completion means every populated session has a time/status for every named driver.
 * Names alone are partial. All sessions required by that round format must be present. */
function resultsEntrySheetProgress_(sheet) {
  return resultsEntryProgressValues_(resultsEntryRoundValues_(sheet));
}
function resultsEntryRoundValues_(sheet){return sheet.getRange(1,1,Math.min(117,sheet.getMaxRows()),7).getDisplayValues();}
function resultsEntryProgressValues_(values){
  if(/^(y|yes)$/i.test(String(values[3]&&values[3][1]||'').trim()))return 'Cancelled';
  const type=String(values[6]&&values[6][0]||''),sprint=/sprint/i.test(type),legacy=/^(early|legacy)\s+sprint/i.test(type);
  const sessions=legacy?[[9,5],[37,6],[94,6]]:sprint?[[9,5],[37,6],[66,5],[94,6]]:[[9,5],[37,6]];
  let any=false;
  const complete=sessions.map(function(s){const rows=values.slice(s[0]-1,s[0]+23).filter(function(r){return String(r[3]).trim()||String(r[s[1]]).trim();});
    if(rows.length)any=true;
    return rows.length>0&&rows.every(function(r){const value=String(r[s[1]]).trim();return !!String(r[3]).trim()&&!!value&&!/^#/.test(value);});
  }).every(Boolean);
  return complete?'Complete':any?'Partial':'Empty';
}

function resultsEntryCancelled_(selection,sheetName){
  const id=PropertiesService.getScriptProperties().getProperty(seasonMasterPropertyKey_(selection.season));if(!id)return false;
  const calendar=SpreadsheetApp.openById(id).getSheetByName('Calendar'),round=Number(String(sheetName).replace(/^R/i,''));
  return !!calendar&&Number.isInteger(round)&&round>0&&round<=F1XL_CAPACITY.rounds&&calendar.getRange('E1').getDisplayValue()==='Status'&&calendar.getRange(round+1,5).getDisplayValue()==='Cancelled';
}

function normaliseResultsEntrySelection_(input) {
  const season = divisionDataText_(input && input.season);
  const division = Number(input && input.division);
  if (!/^\d+(?:\.5)?$/.test(season)) throw new Error('Choose a generated season first.');
  if (!Number.isInteger(division) || division < 1 || division > F1XL_CAPACITY.divisions) {
    throw new Error('Choose a connected Division first.');
  }
  return { season:season, division:division };
}

function openResultsEntryContext_(selection) {
  const properties = PropertiesService.getScriptProperties();
  const spreadsheetId = properties.getProperty(divisionTemplatePropertyKey_(selection.season, selection.division));
  if (!spreadsheetId) throw new Error('Season ' + selection.season + ' Division ' + selection.division + ' is not connected. Create its Division workbook first.');
  const spreadsheet = SpreadsheetApp.openById(spreadsheetId);
  const dataSheet = spreadsheet.getSheetByName('Data');
  const calendarSheet = spreadsheet.getSheetByName('Race Calendar');
  if (!dataSheet || !calendarSheet) throw new Error('The selected Division workbook is missing its Data or Race Calendar tab.');
  return { spreadsheet:spreadsheet, dataSheet:dataSheet, calendarSheet:calendarSheet };
}

function resultsEntryDivisionCacheKey_(selection) {
  return F1XL_RESULTS_ENTRY.divisionCachePrefix + String(selection.season).replace(/[^A-Za-z0-9_-]/g, '_') + '_D' + selection.division;
}

function resultsEntryRoundCacheKey_(selection, sheetName) {
  return F1XL_RESULTS_ENTRY.roundCachePrefix + String(selection.season).replace(/[^A-Za-z0-9_-]/g, '_') + '_D' + selection.division + '_' + String(sheetName).replace(/[^A-Za-z0-9_-]/g, '_');
}
