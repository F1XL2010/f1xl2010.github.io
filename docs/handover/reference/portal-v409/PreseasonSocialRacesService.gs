/** Lightweight, season-owned social-race administration. Names are deliberately
 * stored as entered: social races can include people who never apply to race. */
const F1XL_SOCIAL_RACES=Object.freeze({
  events:{name:'Social Races',headers:['Event ID','Date','Title / track','Entrants','Lobbies','Status','Notes','Updated at']},
  entrants:{name:'Social Race Entrants',headers:['Event ID','Lobby','Entrant','Grid','Finish','Result status','Notes']}
});

function socialRaceContext_(season){
  season=seasonPlanningSeason_(season);const book=seasonPlanningBook_(season);
  if(!book||!seasonMasterIsPlanning_(book))throw new Error('Social races are available only while this Season Master is in pre-season.');
  const plan=seasonPlanningRead_(book.getSheetByName(F1XL_SEASON_PLANNING.sheetName),season,book).plan,data={};
  Object.keys(F1XL_SOCIAL_RACES).forEach(function(key){
    const definition=F1XL_SOCIAL_RACES[key],sheet=book.getSheetByName(definition.name),headers=sheet&&sheet.getLastRow()?sheet.getRange(1,1,1,definition.headers.length).getDisplayValues()[0]:null;
    if(headers&&JSON.stringify(headers)!==JSON.stringify(definition.headers))throw new Error(definition.name+' has an unrecognised layout. Nothing was changed.');
    if(sheet&&sheet.getLastRow()>1&&sheet.getRange(2,1,sheet.getLastRow()-1,definition.headers.length).getFormulas().some(function(row){return row.some(Boolean);})){throw new Error(definition.name+' contains manual formulas. Review them before using Social races.');}
    data[key]={sheet:sheet,rows:sheet&&sheet.getLastRow()>1?sheet.getRange(2,1,sheet.getLastRow()-1,definition.headers.length).getDisplayValues().filter(function(row){return row[0];}):[]};
  });
  return {season:season,book:book,plan:plan,data:data,revision:intakeHash_([plan.socials||[],data.events.rows,data.entrants.rows])};
}

function socialRaceId_(date){return 'SOCIAL-'+String(date||'').replace(/-/g,'');}
function socialRaceText_(value){return String(value==null?'':value).trim();}
function socialRaceNameKey_(value){return socialRaceText_(value).toLowerCase();}
function socialRaceEventRows_(context){
  const saved={};context.data.events.rows.forEach(function(row){saved[row[0]]=row;});
  return (context.plan.socials||[]).map(function(date){const id=socialRaceId_(date),row=saved[id]||[id,date,'','','','','',''];return [id,date,row[2],row[3],row[4],row[5],row[6],row[7]];});
}
function socialRaceResponse_(context){
  const entries=context.data.entrants.rows.map(function(row){return {eventId:row[0],lobby:Number(row[1]||0),entrant:row[2],grid:Number(row[3]||0),finish:row[4]===''?'':Number(row[4]),status:row[5]||'Pending',notes:row[6]||''};});
  const events=socialRaceEventRows_(context).map(function(row){
    const eventEntries=entries.filter(function(entry){return entry.eventId===row[0];}),lobbies=[...new Set(eventEntries.map(function(entry){return entry.lobby;}).filter(Boolean))].sort(function(a,b){return a-b;}),complete=eventEntries.length&&eventEntries.every(function(entry){return entry.status==='Finished'||entry.status==='DNF'||entry.status==='DNS';});
    return {id:row[0],date:row[1],title:row[2]||'',notes:row[6]||'',entrants:eventEntries,lobbies:lobbies,status:complete?'Results saved':lobbies.length?'Lobbies ready':eventEntries.length?'Ready to shuffle':'No entrants',updatedAt:row[7]||''};
  });
  return {season:context.season,url:context.book.getUrl(),revision:context.revision,events:events,message:''};
}
function getPreseasonSocialRaces(season){ fapAssertEntry_('getPreseasonSocialRaces');return socialRaceResponse_(socialRaceContext_(season)); }
function socialRaceRequire_(input,context){if(!input||String(input.revision||'')!==context.revision)throw new Error('Social race data changed since you opened it. Refresh before saving.');const id=String(input.eventId||'');if(!socialRaceEventRows_(context).some(function(row){return row[0]===id;}))throw new Error('Choose a scheduled social race.');return id;}
function socialRaceTableWrite_(context,key,rows,writes){
  const definition=F1XL_SOCIAL_RACES[key];let sheet=context.data[key].sheet;if(!sheet)sheet=context.book.insertSheet(definition.name);
  const values=[definition.headers].concat(rows.map(function(row){return definition.headers.map(function(_,i){return row[i]==null?'':row[i];});})),height=Math.max(values.length,sheet.getLastRow());
  if(height>sheet.getMaxRows())sheet.insertRowsAfter(sheet.getMaxRows(),height-sheet.getMaxRows());if(definition.headers.length>sheet.getMaxColumns())sheet.insertColumnsAfter(sheet.getMaxColumns(),definition.headers.length-sheet.getMaxColumns());while(values.length<height)values.push(definition.headers.map(function(){return '';}));writes.push({range:sheet.getRange(1,1,height,definition.headers.length),values:values,text:true});
}
function socialRaceSave_(context,events,entrants,message){const writes=[];socialRaceTableWrite_(context,'events',events,writes);socialRaceTableWrite_(context,'entrants',entrants,writes);intakeCommit_(writes);Object.keys(F1XL_SOCIAL_RACES).forEach(function(key){const sheet=context.book.getSheetByName(F1XL_SOCIAL_RACES[key].name);try{sheet.setFrozenRows(1);sheet.getRange(1,1,1,F1XL_SOCIAL_RACES[key].headers.length).setFontWeight('bold');}catch(error){}});const response=getPreseasonSocialRaces(context.season);response.message=message;return response;}
function socialRaceEventRecord_(context,id,events){let row=events.find(function(item){return item[0]===id;});if(!row){const planned=socialRaceEventRows_(context).find(function(item){return item[0]===id;});row=[id,planned[1],'','','','','',''];events.push(row);}return row;}
function savePreseasonSocialRaceDetails(input){ fapAssertEntry_('savePreseasonSocialRaceDetails');return withApplicationLock_(function(){const context=socialRaceContext_(input.season),id=socialRaceRequire_(input,context),events=context.data.events.rows.map(function(row){return row.slice();}),entrants=context.data.entrants.rows.map(function(row){return row.slice();}),row=socialRaceEventRecord_(context,id,events),title=socialRaceText_(input.title),notes=socialRaceText_(input.notes);if(title.length>120||notes.length>5000)throw new Error('Keep the track/title within 120 characters and notes within 5,000 characters.');row[2]=title;row[6]=notes;row[7]=new Date().toISOString();return socialRaceSave_(context,events,entrants,'Social race details saved.');});}
function socialRaceParseEntrants_(value){const seen={},duplicates=[],names=[];String(value||'').replace(/\r/g,'').split('\n').map(function(line){return line.trim().replace(/^(?:[•*\-]|\d+[.)])\s*/,'');}).filter(Boolean).forEach(function(name){if(name.length>120)throw new Error('Each entrant name must be 120 characters or fewer.');const key=socialRaceNameKey_(name);if(seen[key]){duplicates.push(name);return;}seen[key]=true;names.push(name);});if(names.length>120)throw new Error('Paste up to 120 entrants at a time.');if(!names.length)throw new Error('Paste at least one entrant, one per line.');return {names:names,duplicates:duplicates};}
function importPreseasonSocialRaceEntrants(input){ fapAssertEntry_('importPreseasonSocialRaceEntrants');return withApplicationLock_(function(){const context=socialRaceContext_(input.season),id=socialRaceRequire_(input,context),parsed=socialRaceParseEntrants_(input.entrants),events=context.data.events.rows.map(function(row){return row.slice();}),row=socialRaceEventRecord_(context,id,events),entrants=context.data.entrants.rows.filter(function(entry){return entry[0]!==id;}).map(function(entry){return entry.slice();});parsed.names.forEach(function(name){entrants.push([id,'',name,'','','Pending','']);});row[3]=String(parsed.names.length);row[4]='';row[5]='Ready to shuffle';row[7]=new Date().toISOString();const response=socialRaceSave_(context,events,entrants,parsed.names.length+' entrant'+(parsed.names.length===1?'':'s')+' imported. Choose lobbies when ready.');if(parsed.duplicates.length)response.message+=' '+parsed.duplicates.length+' duplicate line'+(parsed.duplicates.length===1?' was':'s were')+' ignored.';return response;});}
function socialRaceShuffle_(items){for(let i=items.length-1;i>0;i-=1){const j=Math.floor(Math.random()*(i+1)),swap=items[i];items[i]=items[j];items[j]=swap;}return items;}
function shufflePreseasonSocialRaceLobbies(input){ fapAssertEntry_('shufflePreseasonSocialRaceLobbies');return withApplicationLock_(function(){const context=socialRaceContext_(input.season),id=socialRaceRequire_(input,context),count=Number(input.lobbyCount),events=context.data.events.rows.map(function(row){return row.slice();}),row=socialRaceEventRecord_(context,id,events),others=context.data.entrants.rows.filter(function(entry){return entry[0]!==id;}).map(function(entry){return entry.slice();}),names=context.data.entrants.rows.filter(function(entry){return entry[0]===id;}).map(function(entry){return entry[2];});if(!Number.isInteger(count)||count<1||count>12)throw new Error('Choose between 1 and 12 lobbies.');if(!names.length)throw new Error('Paste entrants before shuffling.');if(count>names.length)throw new Error('Use no more lobbies than entrants.');const perLobby=Array.from({length:count},function(){return 0;});socialRaceShuffle_(names.slice()).forEach(function(name,index){const lobby=index%count;perLobby[lobby]+=1;others.push([id,String(lobby+1),name,String(perLobby[lobby]),'','Pending','']);});row[3]=String(names.length);row[4]=String(count);row[5]='Lobbies ready';row[7]=new Date().toISOString();return socialRaceSave_(context,events,others,'Entrants shuffled into '+count+' lobb'+(count===1?'y.':'ies.'));});}
function savePreseasonSocialRaceLobbies(input){ fapAssertEntry_('savePreseasonSocialRaceLobbies');return withApplicationLock_(function(){const context=socialRaceContext_(input.season),id=socialRaceRequire_(input,context),assignments=Array.isArray(input.assignments)?input.assignments:[],events=context.data.events.rows.map(function(row){return row.slice();}),row=socialRaceEventRecord_(context,id,events),current=context.data.entrants.rows.filter(function(entry){return entry[0]===id;});if(!current.length)throw new Error('Paste entrants before saving lobbies.');const original=new Set(current.map(function(entry){return socialRaceNameKey_(entry[2]);})),seen={},byName={};assignments.forEach(function(entry){const key=socialRaceNameKey_(entry&&entry.entrant);if(!original.has(key)||seen[key])throw new Error('The lobby list changed. Refresh before saving.');const lobby=Number(entry.lobby);if(!Number.isInteger(lobby)||lobby<1||lobby>12)throw new Error('Each entrant needs a lobby between 1 and 12.');seen[key]=true;byName[key]={lobby:lobby};});if(Object.keys(seen).length!==current.length)throw new Error('Assign every entrant to a lobby.');const order={};const rows=context.data.entrants.rows.map(function(entry){if(entry[0]!==id)return entry.slice();const update=byName[socialRaceNameKey_(entry[2])],lobby=update.lobby;order[lobby]=(order[lobby]||0)+1;return [id,String(lobby),entry[2],String(order[lobby]),'','Pending',entry[6]||''];});const lobbies=[...new Set(rows.filter(function(entry){return entry[0]===id;}).map(function(entry){return entry[1];}))];row[4]=String(lobbies.length);row[5]='Lobbies ready';row[7]=new Date().toISOString();return socialRaceSave_(context,events,rows,'Lobby changes saved.');});}
function savePreseasonSocialRaceResults(input){ fapAssertEntry_('savePreseasonSocialRaceResults');return withApplicationLock_(function(){const context=socialRaceContext_(input.season),id=socialRaceRequire_(input,context),lobby=Number(input.lobby),results=Array.isArray(input.results)?input.results:[],events=context.data.events.rows.map(function(row){return row.slice();}),row=socialRaceEventRecord_(context,id,events),current=context.data.entrants.rows.filter(function(entry){return entry[0]===id&&Number(entry[1])===lobby});if(!current.length)throw new Error('Choose a lobby with entrants.');const allowed=['Pending','Finished','DNF','DNS'],expected=new Set(current.map(function(entry){return socialRaceNameKey_(entry[2]);})),seen={},updates={},finishes={};results.forEach(function(result){const key=socialRaceNameKey_(result&&result.entrant),status=socialRaceText_(result&&result.status)||'Pending',finish=socialRaceText_(result&&result.finish),notes=socialRaceText_(result&&result.notes);if(!expected.has(key)||seen[key])throw new Error('The result list changed. Refresh before saving.');if(allowed.indexOf(status)<0||notes.length>5000)throw new Error('Check the result status and notes.');if(status==='Finished'){if(!/^\d+$/.test(finish)||Number(finish)<1||Number(finish)>current.length||finishes[finish])throw new Error('Finished drivers need unique positions.');finishes[finish]=true;}else if(finish)throw new Error('Only finished drivers can have a position.');seen[key]=true;updates[key]={finish:finish,status:status,notes:notes};});if(Object.keys(seen).length!==current.length)throw new Error('Record every driver in this lobby.');const rows=context.data.entrants.rows.map(function(entry){if(entry[0]!==id||Number(entry[1])!==lobby)return entry.slice();const update=updates[socialRaceNameKey_(entry[2])];return [entry[0],entry[1],entry[2],entry[3],update.finish,update.status,update.notes];});row[5]='Results in progress';row[7]=new Date().toISOString();return socialRaceSave_(context,events,rows,'Lobby '+lobby+' results saved.');});}
